{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillRegistry",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "domain"
        ]
      }
    }
  },
  "required": [
    "version",
    "skills"
  ]
}