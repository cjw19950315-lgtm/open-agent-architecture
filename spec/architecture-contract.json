{
  "schemaVersion": 3,
  "framework": "Open Agent Architecture (OAA)",
  "version": "1.3.0",
  "updatedAt": "2026-08-02",
  "purpose": "Governance-first Agent Runtime and Reference Architecture: single verifiable contract for 12-Factor AI Agent governance, including Obsidian ground-truth vault and cross-session Harness",
  "positioning": {
    "runtime": true,
    "referenceArchitecture": true,
    "governanceFirst": true,
    "productionFramework": false
  },
  "operatingModel": {
    "controlPlane": {
      "orchestrator": "OAA ControlPlane (oaa/control.py)",
      "dagEngine": "OAA DAGExecutor (oaa/dag.py)",
      "executorLayer": "Sandboxed Executor & QA Gate (oaa/verification.py + oaa/security.py)",
      "memoryStore": {
        "ingestion": "IngestionStore (unconfirmed)",
        "groundTruth": "Obsidian Markdown Vault via GroundTruthStore (human-only writes)",
        "session": "SessionHarness (cross-session task state, checkpoints, receipts)"
      }
    },
    "harness": {
      "purpose": "Cross-session task state, checkpoints and cryptographic receipts",
      "checkpointMinutes": 15,
      "stateFormat": "JSON receipts + git-backed history",
      "survivesCompaction": true,
      "resumeAfterRestart": true
    },
    "obsidian": {
      "purpose": "Human ground truth for decisions, reviews and long-term experience",
      "format": "Markdown vault",
      "authority": "Human-confirmed content is authoritative over AI-generated content",
      "agentWritesDenied": true
    },
    "factors": [
      "Factor 1: Single Control Plane",
      "Factor 2: Context Budgeting",
      "Factor 3: Structured Outputs & Gates",
      "Factor 4: Controlled Tool Routing",
      "Factor 5: Fast-Path Execution",
      "Factor 6: Memory Separation (Obsidian Vault + Session Harness)",
      "Factor 7: Auditable DAG",
      "Factor 8: Cryptographic Receipts",
      "Factor 9: Self-Evolution Loop",
      "Factor 10: Zero-Trust Security Boundary",
      "Factor 11: Ecosystem Multi-Language Support",
      "Factor 12: Independent Delivery & Gates"
    ],
    "taskStates": [
      "pending", "running", "awaiting_approval", "paused", "degraded", "blocked", "failed", "cancelled", "passed"
    ],
    "runtimeStates": [
      "CREATED", "PLANNING", "READY", "RUNNING", "WAITING_APPROVAL", "VERIFYING", "PASSED", "FAILED", "CANCELLED"
    ],
    "multiLanguageSupport": ["en-US", "zh-CN", "ja-JP", "es-ES", "de-DE"],
    "securityPolicy": {
      "sandboxMode": "workspace-write",
      "sanitizer": "automatic-credential-masking",
      "approvalPolicy": "explicit-user-escalation-for-write-outside-workspace",
      "pathIsolation": true,
      "commandPolicy": "scaffolded-not-wired"
    }
  }
}